mainmenu "Reflow oven firmware"

menu "Reflow oven"

comment "Control core"

config REFLOW_CTRL_PERIOD_MS
	int "Control loop period (ms)"
	default 100
	range 10 1000
	help
	  Cadence of the control thread. It drives the SSR window modulation
	  and the profile state machine.

config REFLOW_SAMPLE_PERIOD_MS
	int "Thermocouple sampling period (ms)"
	default 250
	range 100 2000
	help
	  A MAX6675 conversion takes about 220 ms; do not go below that.

config REFLOW_PUBLISH_PERIOD_MS
	int "Telemetry publish period (ms)"
	default 500
	range 100 5000

config REFLOW_ABS_MAX_TEMP_C
	int "Absolute over-temperature cut-out (degC)"
	default 270
	range 60 400
	help
	  Firmware backstop, checked independently of the running profile.
	  It does NOT replace a hardware thermal fuse.

config REFLOW_CTRL_STACK_SIZE
	int "Control thread stack size"
	default 2048

config REFLOW_CTRL_PRIORITY
	int "Control thread priority"
	default 5
	help
	  Lower is higher priority. Keep it above the UI and network threads.

comment "Heater output"

config REFLOW_HEATER_WINDOW_MS
	int "Slow PWM window (ms)"
	default 1000
	range 100 10000

config REFLOW_HEATER_MIN_PULSE_MS
	int "Shortest pulse the SSR is allowed to receive (ms)"
	default 50
	range 0 1000
	help
	  Duties that would produce a shorter pulse are snapped to 0 % or 100 %.

config REFLOW_HEATER_STALE_MS
	int "Force the output off if no duty update within (ms)"
	default 2000
	range 200 10000
	help
	  Fail-safe: if the control loop stops updating the request, the
	  element is switched off.

comment "PID gains (milli-units: 40000 means 40.0)"

config REFLOW_PID_KP_MILLI
	int "Kp, permille of duty per degC of error"
	default 60000

config REFLOW_PID_KI_MILLI
	int "Ki"
	default 2000

config REFLOW_PID_KD_MILLI
	int "Kd"
	default 250000

config REFLOW_PID_I_CLAMP
	int "Integral term clamp (permille)"
	default 1000
	help
	  A heater needs most of its steady-state duty to come from the
	  integral term, so this is deliberately as large as the output range.

config REFLOW_PID_D_ALPHA_MILLI
	int "Derivative low-pass coefficient (milli, 1000 = off)"
	default 200
	range 1 1000

comment "Optional features"

config REFLOW_UI_DISPLAY
	bool "Local display UI (LVGL)"
	select DISPLAY
	select LVGL
	help
	  ST7789-class colour panel described by the 'zephyr,display' chosen
	  node. Purely an observer of the telemetry channel.

config REFLOW_UI_DISPLAY_STACK_SIZE
	int "Display thread stack size"
	default 4096
	depends on REFLOW_UI_DISPLAY

config REFLOW_UI_INPUT
	bool "Rotary encoder and button"
	select INPUT
	help
	  Uses gpio-qdec and gpio-keys nodes through the input subsystem.

config REFLOW_SHELL
	bool "Serial console commands"
	select SHELL
	default y
	help
	  'reflow status|start|stop|clear|profile' on the console. Very useful
	  during bring-up; can be removed from a production build.

config REFLOW_NET
	bool "Web UI over the network"
	select NETWORKING
	select NET_IPV4
	select NET_TCP
	select NET_SOCKETS
	select NET_MGMT
	select NET_MGMT_EVENT
	select NET_CONNECTION_MANAGER
	help
	  Single page web UI with a live temperature plot, served by an HTTP
	  server written on plain BSD sockets. The server does not care how the
	  link is provided - pick that below.

# Credentials stay outside the 'if' below so that setting them in prj.conf
# never warns in a build without networking.
config REFLOW_WIFI_SSID
	string "Wi-Fi SSID"
	default "changeme"

config REFLOW_WIFI_PSK
	string "Wi-Fi passphrase (empty for an open network)"
	default ""

if REFLOW_NET

choice REFLOW_LINK
	prompt "Network link for the web UI"
	default REFLOW_LINK_WIFI

config REFLOW_LINK_WIFI
	bool "Wi-Fi station"
	select WIFI
	# wifi.c calls net_mgmt(NET_REQUEST_WIFI_CONNECT). The request handler
	# lives in the Wi-Fi L2 management layer, and WIFI alone does not bring
	# it in: each vendor driver selects it. On a target with no Wi-Fi driver
	# (native_sim, the modularity matrix) the link then fails with
	# 'undefined reference to net_mgmt_NET_REQUEST_WIFI_CONNECT'. The
	# feature uses the API, so the feature declares it.
	select NET_L2_WIFI_MGMT
	help
	  Joins an existing network. Needs a radio: fine on ESP32, not
	  available on a bare RP2350.

config REFLOW_LINK_USB_ECM
	bool "USB Ethernet (CDC ECM)"
	select USB_DEVICE_STACK_NEXT
	select NET_L2_ETHERNET
	select NET_DHCPV4_SERVER
	select HWINFO
	help
	  The oven appears as a USB Ethernet adapter on the same cable that
	  powers it, and hands the host an address over DHCP. No radio needed.

	  Host support: Linux and macOS bind CDC ECM out of the box; Windows
	  has no in-box ECM driver and needs a third party one.

	  Requires a zephyr,cdc-ecm-ethernet node in the devicetree, and
	  CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT must be off, because this
	  module initialises the USB device stack itself (registering the
	  shell's CDC ACM function along with the Ethernet one).

endchoice

if REFLOW_LINK_USB_ECM

config REFLOW_USB_IPV4_ADDR
	string "Oven address on the USB link"
	default "192.168.7.1"

config REFLOW_USB_IPV4_MASK
	string "Netmask of the USB link"
	default "255.255.255.0"

config REFLOW_USB_DHCP_POOL_START
	string "First address handed to the host"
	default "192.168.7.2"

config REFLOW_USB_VID
	hex "USB vendor ID"
	default 0x2fe3
	help
	  0x2fe3 is the Zephyr project VID, acceptable for local development
	  only. Use your own VID/PID pair before distributing hardware.

config REFLOW_USB_PID
	hex "USB product ID"
	default 0x0007

config REFLOW_USB_MANUFACTURER
	string "USB manufacturer string"
	default "Reflow oven project"

config REFLOW_USB_PRODUCT
	string "USB product string"
	default "Reflow oven"

endif # REFLOW_LINK_USB_ECM

config REFLOW_NET_TOKEN
	string "Shared secret required to command the oven over HTTP"
	default ""
	help
	  Sent by the web UI in the X-Reflow-Token header of POST /api/cmd, and
	  compared byte for byte before any command reaches the control core.

	  Deliberately inside `if REFLOW_NET`, and deliberately empty by default:
	  an EMPTY TOKEN DISABLES REMOTE COMMANDS ENTIRELY (the endpoint answers
	  503). A build that accepted anonymous commands because nobody set a
	  token would be the RFO-B02 defect with a friendlier face.

	  Not a substitute for a network you trust: the link is plain HTTP, so
	  anyone able to capture the traffic can replay the token. It closes the
	  drive-by-from-the-browser and the anyone-on-the-LAN cases, not the
	  wiretap one.

	  Do NOT put it in the served page. The UI asks the operator for it and
	  keeps it in memory only.

config REFLOW_NET_HTTP_PORT
	int "HTTP port"
	default 80

config REFLOW_NET_MAX_CLIENTS
	int "Simultaneous HTTP connections"
	default 4
	range 1 8

config REFLOW_NET_PUSH_PERIOD_MS
	int "Server-sent events push period (ms)"
	default 1000
	range 200 10000

config REFLOW_NET_STACK_SIZE
	int "HTTP server thread stack size"
	default 4096

endif # REFLOW_NET

module = REFLOW
module-str = reflow
source "subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"

# Subsystem tuning that belongs to a feature, kept here instead of in
# prj.conf so that switching the feature off really removes it from the image.
# 'configdefault' only supplies a default: anything set explicitly in prj.conf
# or on the command line still wins. Requires Zephyr 3.7 or newer.

# --- display UI (LVGL) ---
configdefault LV_Z_MEM_POOL_SIZE
	default 24576 if REFLOW_UI_DISPLAY

configdefault LV_Z_VDB_SIZE
	default 16 if REFLOW_UI_DISPLAY

configdefault LV_FONT_MONTSERRAT_28
	default y if REFLOW_UI_DISPLAY

configdefault LV_USE_LOG
	default n if REFLOW_UI_DISPLAY

# --- encoder / button ---
configdefault INPUT_GPIO_QDEC
	default y if REFLOW_UI_INPUT

configdefault INPUT_GPIO_KEYS
	default y if REFLOW_UI_INPUT

# --- web UI ---
# DHCP client for the Wi-Fi link only: on the USB link the oven is the server.
configdefault NET_DHCPV4
	default y if REFLOW_LINK_WIFI

# Sockets poll() sizing lives in ZVFS since NET_SOCKETS started selecting it
# (the old NET_SOCKETS_POLL_MAX no longer exists). The web UI polls one
# listening socket plus REFLOW_NET_MAX_CLIENTS connections.
configdefault ZVFS_POLL_MAX
	default 8 if REFLOW_NET

configdefault NET_MAX_CONTEXTS
	default 10 if REFLOW_NET

configdefault NET_MAX_CONN
	default 8 if REFLOW_NET

configdefault NET_PKT_RX_COUNT
	default 16 if REFLOW_NET

configdefault NET_PKT_TX_COUNT
	default 16 if REFLOW_NET

configdefault NET_BUF_RX_COUNT
	default 32 if REFLOW_NET

configdefault NET_BUF_TX_COUNT
	default 32 if REFLOW_NET

configdefault HEAP_MEM_POOL_SIZE
	default 32768 if REFLOW_NET

# Espressif Wi-Fi driver: the symbol only exists on Espressif SoCs, so this is
# a no-op on any other target.
configdefault WIFI_ESP32
	default y if REFLOW_LINK_WIFI

configdefault NET_L2_ETHERNET
	default y if REFLOW_NET

# --- shell ---
configdefault SHELL_STACK_SIZE
	default 4096 if REFLOW_SHELL

# Identity of the CDC ACM console helper, when a board fragment enables it.
# As defaults rather than assignments, so they simply do not apply in builds
# where usb_net.c owns the USB device stack instead.
configdefault CDC_ACM_SERIAL_PID
	default 0x0004 if REFLOW_SHELL

configdefault CDC_ACM_SERIAL_PRODUCT_STRING
	default "Reflow oven" if REFLOW_SHELL
