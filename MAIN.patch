-
-	if (strstr(query, "id=start") != NULL) {
-		cmd.id = REFLOW_CMD_START;
-		cmd.arg = 0;
-	} else if (strstr(query, "id=stop") != NULL) {
-		cmd.id = REFLOW_CMD_STOP;
-		cmd.arg = 0;
-	} else if (strstr(query, "id=clear") != NULL) {
