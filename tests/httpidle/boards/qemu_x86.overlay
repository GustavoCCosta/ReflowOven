/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * SIMULATION ONLY -- nothing here describes hardware.
 *
 * The subject of this suite is the http server, but the image links the
 * control core with it (httpd.c needs the telemetry channel and
 * reflow_cmd_post()), so heater.c needs its SSR node. There is deliberately no
 * thermocouple node: src/core/temp.c is not in this image,
 * tests/controller/src/temp_fake.c is.
 *
 * qemu_x86 has no GPIO controller of its own, so the emulator is declared here.
 * Pin 15 and GPIO_ACTIVE_HIGH mirror tests/boot and the application overlays.
 *
 * Nothing about the network is declared: the only interface in this image is
 * the software loopback, which is a Kconfig symbol and not a devicetree node.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	gpio_emul0: gpio_emul0 {
		compatible = "zephyr,gpio-emul";
		gpio-controller;
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		#gpio-cells = <2>;
		ngpios = <32>;
		status = "okay";
	};

	reflow_outputs {
		compatible = "gpio-leds";

		ssr0: ssr_0 {
			gpios = <&gpio_emul0 15 GPIO_ACTIVE_HIGH>;
			label = "SSR heater (emulated)";
		};
	};

	aliases {
		reflow-ssr = &ssr0;
	};
};
