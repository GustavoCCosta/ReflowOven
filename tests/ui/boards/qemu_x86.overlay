/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * SIMULATION ONLY -- nothing here describes hardware.
 *
 * Only the SSR gate is declared. There is deliberately no thermocouple node:
 * src/core/temp.c is not in this image, tests/controller/src/temp_fake.c is,
 * and the whole point of the suite is that the reading comes from the test
 * instead of from a bus.
 *
 * qemu_x86 has no GPIO controller of its own, so the emulator is declared here.
 * Pin 15 and GPIO_ACTIVE_HIGH mirror tests/boot and the application overlays.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	gpio_emul0: gpio_emul0 {
		compatible = "zephyr,gpio-emul";
		gpio-controller;
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		#gpio-cells = <2>;
		ngpios = <32>;
		status = "okay";
	};

	reflow_outputs {
		compatible = "gpio-leds";

		ssr0: ssr_0 {
			gpios = <&gpio_emul0 15 GPIO_ACTIVE_HIGH>;
			label = "SSR heater (emulated)";
		};
	};

	/*
	 * RFO-B12: o display_ui.c exige um no `zephyr,display` escolhido, em
	 * tempo de compilacao (o #error dele). O driver dummy do Zephyr da esse
	 * no numa plataforma simulada, e o LVGL sobe em cima dele - a suite nao
	 * precisa de painel de verdade, precisa de um device cuja prontidao ela
	 * possa negar.
	 */
	dummy_display: dummy_dc {
		compatible = "zephyr,dummy-dc";
		height = <240>;
		width = <320>;
	};

	chosen {
		zephyr,display = &dummy_display;
	};

	aliases {
		reflow-ssr = &ssr0;
	};
};
