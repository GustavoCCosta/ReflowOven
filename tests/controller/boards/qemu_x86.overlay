/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * SIMULATION ONLY -- nothing here describes hardware.
 *
 * Only the SSR gate is declared. There is deliberately no thermocouple node:
 * src/core/temp.c is not in this image, tests/controller/src/temp_fake.c is,
 * and the whole point of the suite is that the reading comes from the test
 * instead of from a bus.
 *
 * qemu_x86 has no GPIO controller of its own, so the emulator is declared here.
 * Pin 15 and GPIO_ACTIVE_HIGH mirror tests/boot and the application overlays.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	gpio_emul0: gpio_emul0 {
		compatible = "zephyr,gpio-emul";
		gpio-controller;
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		#gpio-cells = <2>;
		ngpios = <32>;
		status = "okay";
	};

	reflow_outputs {
		compatible = "gpio-leds";

		ssr0: ssr_0 {
			gpios = <&gpio_emul0 15 GPIO_ACTIVE_HIGH>;
			label = "SSR heater (emulated)";
		};
	};

	aliases {
		reflow-ssr = &ssr0;
	};
};
