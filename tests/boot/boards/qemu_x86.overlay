/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * SIMULATION ONLY — nothing here describes hardware. qemu_x86 has no GPIO
 * controller of its own, so this declares an emulated one and hangs the SSR
 * node off it, giving the suite somewhere to look for the gate.
 *
 * Why qemu_x86 at all, when native_sim already has an emulator: native_sim does
 * not run on Windows (twister filters it with "Native platform requires Linux",
 * PROCESSO.md section 10), and this suite has to be runnable on the machine the
 * firmware is developed on. Both platforms build the same source and assert the
 * same thing.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	gpio_emul0: gpio_emul0 {
		compatible = "zephyr,gpio-emul";
		gpio-controller;
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		#gpio-cells = <2>;
		ngpios = <32>;
		status = "okay";
	};

	reflow_outputs {
		compatible = "gpio-leds";

		ssr0: ssr_0 {
			gpios = <&gpio_emul0 15 GPIO_ACTIVE_HIGH>;
			label = "SSR heater (emulated)";
		};
	};

	aliases {
		reflow-ssr = &ssr0;
	};
};
